# pgsql MCP 连接配置样例（仅供参考，请按实际调整）
# 在使用前请拷贝为 .env 并填入真实值；.env 不要提交到版本控制。

# 方式一：直接给出连接字符串
PG_CONNECTION_STRING=postgresql://user:password@localhost:5432/postgres

# 方式二：使用拆分字段（与 PG_CONNECTION_STRING 二选一，留空即可）
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=user
# PG_PASSWORD=password
# PG_DATABASE=postgres
