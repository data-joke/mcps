# 图片识别模型配置
# 请根据使用的模型提供商配置相应的环境变量

# 必填：模型 API 地址、密钥、模型名称
VISION_MODEL_BASE_URL=
VISION_MODEL_API_KEY=
VISION_MODEL_NAME=

# 可选：输出最大 token（默认 4096）
VISION_MODEL_MAX_TOKENS=4096

# 可选：批量识别并发数（默认 4，建议 1-8）
VISION_BATCH_CONCURRENCY=4

# 可选：模型偶发拒绝视觉时的重试次数（默认 1）
VISION_RETRY=1

# ------------------------------------------------------------
# 以下为各厂商配置示例，取消注释并填入你的密钥即可使用
# ⚠️ 示例 base_url 仅供参考，以厂商官方文档为准
# ------------------------------------------------------------

# 通义千问（DashScope 兼容模式）
# VISION_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL_API_KEY=your-qwen-api-key
# VISION_MODEL_NAME=qwen-vl-plus

# Kimi (Moonshot)
# VISION_MODEL_BASE_URL=https://api.moonshot.cn/v1
# VISION_MODEL_API_KEY=your-kimi-api-key
# VISION_MODEL_NAME=moonshot-v1-8k-vision
# 注意：Moonshot 需在 VISION_MODEL_BASE_URL 追加 /v1，且支持 OpenAI 兼容格式

# MiniMax
# VISION_MODEL_BASE_URL=https://api.minimax.chat/v1
# VISION_MODEL_API_KEY=your-minimax-api-key
# VISION_MODEL_NAME=minimax-vision

# 智谱 GLM
# VISION_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VISION_MODEL_API_KEY=your-zhipu-api-key
# VISION_MODEL_NAME=glm-4v

# OpenCode Go（本机当前使用，mimo-v2.5 推理 + 多模态）
# VISION_MODEL_BASE_URL=https://opencode.ai/zen/go/v1
# VISION_MODEL_API_KEY=sk-<你的 OpenCode Go API Key>
# VISION_MODEL_NAME=mimo-v2.5
# VISION_MODEL_MAX_TOKENS=4096
