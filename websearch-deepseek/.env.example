# 联网搜索 MCP 配置（示例，请按实际调整）

# 必填：后端 API Key
WEBSEARCH_API_KEY=

# 后端二选一（都是 OpenAI Responses 协议，代码零改动）：
#  DeepSeek 官方：https://api.deepseek.com/v1
#  OpenCode Go： https://opencode.ai/zen/go/v1
WEBSEARCH_BASE_URL=https://api.deepseek.com/v1

# 可选：默认模型（deepseek-v4-flash 便宜快，适合搜索；也可用 deepseek-v4-pro）
WEBSEARCH_MODEL=deepseek-v4-flash

# 可选：输出最大 token / 超时秒数
WEBSEARCH_MAX_TOKENS=4096
WEBSEARCH_TIMEOUT=60
